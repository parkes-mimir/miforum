{
  "name": "miforum",
  "version": "1.4.2",
  "private": true,
  "license": "MIT",
  "lint-staged": {
    "src/**/*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "tests/**/*.js": [
      "prettier --write"
    ]
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prod": "pm2 start src/server.js --name miforum && pm2 save",
    "stop": "pm2 stop miforum",
    "restart": "pm2 restart miforum",
    "logs": "pm2 logs miforum",
    "test": "jest --verbose --forceExit --detectOpenHandles",
    "test:e2e": "npx playwright test",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "backup": "./scripts/backup-db.sh"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 10000
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "better-sqlite3-session-store": "^0.1.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.1.1",
    "pm2": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^8.50.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
