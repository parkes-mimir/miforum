# MiForum 环境变量配置
# 复制此文件为 .env 并修改配置

# 服务器端口
PORT=3000

# Session 密钥（生产环境请修改为随机字符串）
SESSION_SECRET=change-me-to-random-string

# 超级管理员账号（首次启动自动创建）
ADMIN_EMAIL=root@miforum.local
ADMIN_PASSWORD=123456

# 环境：development / production
NODE_ENV=development

# Cookie secure 标志（HTTPS 环境设为 true，HTTP 留空或 false）
COOKIE_SECURE=false

# GitHub 镜像（国内 Docker 环境自动更新用，留空直连）
# 例：GITHUB_MIRROR=https://ghproxy.com
GITHUB_MIRROR=

# SMTP 邮箱配置（用于发送验证码）
# QQ邮箱示例：
#   SMTP_HOST=smtp.qq.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your@qq.com
#   SMTP_PASS=your-smtp-password（非QQ密码，在QQ邮箱设置中获取）
# 163邮箱示例：
#   SMTP_HOST=smtp.163.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your@163.com
#   SMTP_PASS=your-smtp-password
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
