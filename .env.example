# MiForum 环境变量配置
# 复制此文件为 .env 并修改配置

# 服务器端口
PORT=3000

# Session 密钥（生产环境必须设置为随机字符串，用于加密和会话安全）
SESSION_SECRET=change-me-in-production

# 超级管理员账号（首次启动自动创建）
ADMIN_EMAIL=root@miforum.local
ADMIN_PASSWORD=123456

# 环境：development / production
NODE_ENV=development

# Cookie secure 标志（HTTPS 环境设为 true，HTTP 留空或 false）
COOKIE_SECURE=false

# CORS 跨域白名单（逗号分隔，留空允许同源）
# 例：CORS_ORIGINS=https://example.com,https://api.example.com
CORS_ORIGINS=

# 数据库文件路径（留空使用默认路径 data/db/data.db）
DB_PATH=

# 上传目录路径（留空使用默认路径 data/uploads）
UPLOADS_PATH=

# 站点 URL（用于 Open Graph 绝对路径，微信分享卡片需要）
# 例：SITE_URL=https://forum.example.com
SITE_URL=

# 在线游戏配置（JSON数组格式，留空不显示）
# 支持多种游戏类型：
#   - 联机游戏：需要单独启动游戏服务
#   - H5游戏：将游戏文件夹放到服务器上，配置HTTP服务
# 示例：
# GAMES=[{"name":"王朝纪元 · 1444","description":"多人联机大战略游戏","url":"http://localhost:7788/gs/"},{"name":"示例RPG","description":"RPG Maker制作的冒险游戏","url":"/games/example/"}]
GAMES=

# 例：GITHUB_MIRROR=https://ghproxy.com
GITHUB_MIRROR=

# 时区偏移（签到日期计算用，默认东八区 +8）
TZ_OFFSET=+8

# SMTP 邮箱配置（用于发送验证码）
# QQ邮箱示例：
#   SMTP_HOST=smtp.qq.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your@qq.com
#   SMTP_PASS=your-smtp-password（非QQ密码，在QQ邮箱设置中获取）
# 163邮箱示例：
#   SMTP_HOST=smtp.163.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your@163.com
#   SMTP_PASS=your-smtp-password
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
