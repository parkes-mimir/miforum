        <button x-show="!channelsData.find(c => c.id === editingChannelId)?.is_official && (channelMembers.some(cm => cm.user_id === Alpine.store('auth').user?.id && cm.role === 'owner') || isSuperAdmin)" @click="deleteChannel(editingChannelId, channelSettingsForm.label)" class="w-full py-2.5 bg-red-50 text-red-500 text-sm font-semibold rounded-xl hover:bg-red-100 transition">删除频道</button>
      </div>
      <!-- Members Tab -->
      <div x-show="channelSettingsTab === 'members'">
        <div class="space-y-2">
          <template x-for="m in channelMembers" :key="m.user_id">
            <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-xl">
              <div x-html="avatarHtml(m.avatar_url, m.username?.[0]?.toUpperCase(), 'w-8 h-8')" class="flex-shrink-0"></div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-gray-900 truncate" x-text="m.username"></span>
                  <span class="text-xs text-gray-400" x-text="'#' + m.display_id"></span>
                  <span x-show="m.role === 'owner'" class="text-xs px-1.5 py-0.5 rounded bg-amber-500 text-white">频道主</span>
                  <span x-show="m.role === 'admin'" class="text-xs px-1.5 py-0.5 rounded bg-primary-500 text-white">管理员</span>
                </div>
              </div>
              <div x-show="m.role !== 'owner'" class="flex gap-1">
                <button x-show="channelMembers.some(cm => cm.user_id === Alpine.store('auth').user?.id && cm.role === 'owner')" @click="transferChannel(m.user_id, m.username)" class="text-xs px-2 py-1 rounded-lg bg-amber-50 text-amber-600 hover:bg-amber-100 transition">转让</button>
                <button x-show="m.role === 'member'" @click="setMemberRole(m.user_id, 'admin')" class="text-xs px-2 py-1 rounded-lg bg-primary-50 text-primary-600 hover:bg-primary-100 transition">设为管理</button>
                <button x-show="m.role === 'admin'" @click="setMemberRole(m.user_id, 'member')" class="text-xs px-2 py-1 rounded-lg bg-gray-100 text-gray-500 hover:bg-gray-200 transition">取消管理</button>
                <button x-show="channelMembers.some(cm => cm.user_id === Alpine.store('auth').user?.id && cm.role === 'owner') || isSuperAdmin" @click="removeMember(m.user_id, m.username)" class="text-xs px-2 py-1 rounded-lg bg-red-50 text-red-500 hover:bg-red-100 transition">移除</button>
              </div>
            </div>
          </template>
