      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1">板块名称</label>
        <input x-model="boardEditForm.label" type="text" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 transition">
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1">简介</label>
        <textarea x-model="boardEditForm.description" rows="2" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 transition resize-none"></textarea>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1">图标</label>
        <input x-model="boardEditForm.icon" type="text" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 transition">
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1">可见性</label>
        <select x-model="boardEditForm.visibility" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 transition bg-white">
          <option value="all">所有人可见</option>
          <option value="members">仅频道成员</option>
          <option value="selected">指定成员</option>
        </select>
      </div>
      <!-- 指定成员管理 -->
      <div x-show="boardEditForm.visibility === 'selected'" class="border border-gray-200 rounded-xl p-3 space-y-2">
        <div class="flex items-center justify-between">
          <label class="text-xs font-medium text-gray-500">可见成员</label>
          <button @click="showBoardMemberSelect()" class="text-xs px-2 py-1 rounded-lg bg-primary-50 text-primary-600 hover:bg-primary-100 transition">添加成员</button>
        </div>
        <div class="space-y-1 max-h-32 overflow-y-auto">
          <template x-for="m in boardVisibleMembers" :key="m.user_id">
            <div class="flex items-center gap-2 p-1.5 bg-gray-50 rounded-lg">
              <div x-html="avatarHtml(m.avatar_url, m.username?.[0]?.toUpperCase(), 'w-5 h-5')" class="flex-shrink-0"></div>
              <span class="text-xs text-gray-700 flex-1 truncate" x-text="m.username"></span>
              <button @click="removeBoardVisibleMember(m.user_id)" class="text-xs text-red-400 hover:text-red-600">移除</button>
            </div>
          </template>
          <p x-show="boardVisibleMembers.length === 0" class="text-xs text-gray-400 text-center py-2">暂无成员</p>
        </div>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1">发帖权限</label>
        <select x-model="boardEditForm.postPolicy" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 transition bg-white">
          <option value="all">所有人可发帖</option>
          <option value="members">仅频道成员</option>
          <option value="selected">指定成员</option>
        </select>
      </div>
    </div>
    <div class="p-5 border-t border-gray-100">
      <button @click="saveBoardEdit()" class="w-full py-2.5 bg-primary-600 text-white text-sm font-semibold rounded-xl hover:bg-primary-700 transition">保存</button>
    </div>
  </div>
</div>

<!-- Board Member Select Modal -->
<div x-show="boardMemberSelectOpen" x-transition.opacity @click.self="boardMemberSelectOpen = false" @keydown.escape.window="if(boardMemberSelectOpen) boardMemberSelectOpen = false" class="fixed inset-0 z-[70] flex items-center justify-center bg-black/40 backdrop-blur-sm" style="display:none" role="dialog" aria-modal="true" aria-label="选择成员">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm mx-4 max-h-[70vh] flex flex-col fade-in">
    <div class="flex items-center justify-between p-5 border-b border-gray-100">
      <h2 class="text-lg font-bold">选择成员</h2>
      <button @click="boardMemberSelectOpen = false" class="p-1 rounded-lg hover:bg-gray-100"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
    </div>
    <div class="flex-1 overflow-y-auto p-5">
      <div class="space-y-2">
        <template x-for="c in boardMemberCandidates" :key="c.user_id">
          <label class="flex items-center gap-3 p-3 bg-gray-50 rounded-xl cursor-pointer hover:bg-gray-100 transition">
            <input type="checkbox" :value="c.user_id" class="board-member-checkbox rounded text-primary-600">
            <div x-html="avatarHtml(c.avatar_url, c.username?.[0]?.toUpperCase(), 'w-8 h-8')" class="flex-shrink-0"></div>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-medium text-gray-900 truncate" x-text="c.username"></div>
              <div class="text-xs text-gray-400" x-text="'#' + c.display_id"></div>
            </div>
          </label>
        </template>
        <p x-show="boardMemberCandidates.length === 0" class="text-sm text-gray-400 text-center py-8">没有可添加的成员</p>
      </div>
    </div>
    <div class="p-5 border-t border-gray-100">
      <button @click="addBoardVisibleMembers(Array.from(document.querySelectorAll('.board-member-checkbox:checked')).map(el => Number(el.value)))" class="w-full py-2.5 bg-primary-600 text-white text-sm font-semibold rounded-xl hover:bg-primary-700 transition">添加选中成员</button>
    </div>
  </div>
</div>

<%- include('partials/scripts') %>
<script src="/js/pages/forum.js?v=1.5.2"></script>
<script src="/js/alpine.min.js?v=1.5.2"></script>
</body>
</html>
