<!-- Channel Settings Modal -->
<div x-show="channelSettingsOpen" x-transition.opacity @click.self="channelSettingsOpen = false" @keydown.escape.window="if(channelSettingsOpen) channelSettingsOpen = false" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm" style="display:none" role="dialog" aria-modal="true" aria-label="频道设置">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg mx-4 max-h-[85vh] flex flex-col fade-in">
    <div class="flex items-center justify-between p-5 border-b border-gray-100">
      <h2 class="text-lg font-bold">频道设置</h2>
      <button @click="channelSettingsOpen = false" class="p-1 rounded-lg hover:bg-gray-100"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
    </div>
    <div class="flex border-b border-gray-100">
      <button @click="channelSettingsTab = 'info'" :class="channelSettingsTab === 'info' ? 'text-primary-600 border-primary-600' : 'text-gray-400 border-transparent'" class="flex-1 py-3 text-sm font-medium border-b-2 transition">信息</button>
      <button @click="channelSettingsTab = 'members'; loadChannelMembers(editingChannelId)" :class="channelSettingsTab === 'members' ? 'text-primary-600 border-primary-600' : 'text-gray-400 border-transparent'" class="flex-1 py-3 text-sm font-medium border-b-2 transition">成员</button>
      <button @click="channelSettingsTab = 'boards'; loadChannelBoardsList(editingChannelId)" :class="channelSettingsTab === 'boards' ? 'text-primary-600 border-primary-600' : 'text-gray-400 border-transparent'" class="flex-1 py-3 text-sm font-medium border-b-2 transition">板块</button>
    </div>
    <div class="flex-1 overflow-y-auto p-5">
      <!-- Info Tab -->
      <div x-show="channelSettingsTab === 'info'" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">频道名称</label>
          <input x-model="channelSettingsForm.label" type="text" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 transition">
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">简介</label>
          <textarea x-model="channelSettingsForm.description" rows="2" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 transition resize-none"></textarea>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">图标</label>
          <input x-model="channelSettingsForm.icon" type="text" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 transition">
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">加入策略</label>
          <select x-model="channelSettingsForm.joinPolicy" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 transition bg-white">
            <option value="open">所有人可加入</option>
            <option value="verify">需要审核</option>
            <option value="deny">不允许加入</option>
          </select>
        </div>
