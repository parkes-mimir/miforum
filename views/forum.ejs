                  <span class="text-xs text-gray-400" x-text="'#' + board.name"></span>
                  <span x-show="board.visibility === 'members'" class="text-xs px-1 py-0.5 rounded bg-blue-50 text-blue-500">仅成员</span>
                  <span x-show="board.visibility === 'selected'" class="text-xs px-1 py-0.5 rounded bg-purple-50 text-purple-500">指定成员</span>
                  <span x-show="board.postPolicy === 'members'" class="text-xs px-1 py-0.5 rounded bg-green-50 text-green-500">成员可发帖</span>
                </div>
              </div>
              <div class="flex gap-1">
                <button @click="showBoardEdit(board)" class="text-xs px-2 py-1 rounded-lg bg-gray-100 text-gray-500 hover:bg-gray-200 transition">编辑</button>
                <button @click="deleteBoard(board)" class="text-xs px-2 py-1 rounded-lg bg-red-50 text-red-500 hover:bg-red-100 transition">删除</button>
              </div>
            </div>
          </template>
          <p x-show="channelBoardsList.length === 0" class="text-sm text-gray-400 text-center py-8">暂无板块</p>
        </div>
      </div>
    </div>
