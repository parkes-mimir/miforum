<!DOCTYPE html>
<html lang="zh-CN" data-theme="<%= theme.theme %>" data-color="<%= theme.themeColor %>">
<head>
<%- include('partials/head', { title: 'MiForum - 现代微论坛', ogTitle: 'MiForum - 现代微论坛', ogDesc: '技术交流与生活分享，Flarum 风格轻量论坛' }) %>
<style>
  .post-card:hover{box-shadow:0 4px 24px rgba(0,0,0,.08)}
  .sidebar-link.active{background:#eef2ff;color:#4f46e5;font-weight:600}
  .streak-num{font-size:1.5rem;font-weight:700;line-height:1}
  .cal-month{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;text-align:center}
  .cal-head{font-size:11px;color:#9ca3af;font-weight:500;padding:4px 0}
  .cal-cell{aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:6px;font-size:13px;cursor:default;transition:all .15s;position:relative;color:#1f2937}
  .cal-cell.checked{position:relative}
  .cal-cell.checked::before{content:'\2713';position:absolute;top:0;left:0;font-size:10px;font-weight:900;color:#fff;background:#16a34a;width:18px;height:18px;display:flex;align-items:center;justify-content:center;border-radius:6px 0 6px 0;line-height:1;z-index:2}
  .cal-cell.missed{cursor:pointer;position:relative}
  .cal-cell.missed::after{content:'\8865';position:absolute;font-size:20px;font-weight:700;color:rgba(239,68,68,.12);pointer-events:none;z-index:0}
  .cal-cell.missed:hover{transform:scale(1.15)}
  .cal-cell.missed:hover::after{color:rgba(239,68,68,.25)}
  .cal-cell.missed span{position:relative;z-index:1}
  .cal-cell.today{outline:2px solid #6366f1;outline-offset:1px;font-weight:700}
  @media (max-width: 639px) {
    .cal-month{gap:2px}
    .cal-cell{font-size:12px}
    .cal-head{font-size:10px;padding:2px 0}
    .streak-num{font-size:1.25rem}
    .post-card:active{transform:scale(0.98)}
    .sidebar-link:active{background:#eef2ff}
  }
  @media (hover: none) {
    .post-card:hover{box-shadow:none}
    .post-card:active{box-shadow:0 4px 24px rgba(0,0,0,.08)}
  }
  @media (max-width: 639px) {
    .search-desktop { display: none !important; }
    .search-mobile { display: block !important; }
  }
  @media (min-width: 640px) {
    .search-desktop { display: block !important; }
    .search-mobile { display: none !important; }
  }
</style>
</head>
<body class="min-h-screen text-gray-800" x-data="forumPage()" x-cloak @open-admin-panel.window="showAdminPanel()" @toggle-sidebar.window="sidebarOpen = !sidebarOpen">

<%- include('partials/header', { subtitle: '', showSidebarToggle: true, showAdminButton: true }) %>

<!-- Sidebar overlay -->
<div x-show="sidebarOpen" @click="sidebarOpen = false" class="fixed inset-0 bg-black/30 z-30 lg:hidden" x-transition.opacity></div>

<div class="max-w-7xl mx-auto flex relative">
  <!-- Sidebar -->
  <aside :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'" class="fixed lg:sticky top-14 left-0 z-30 w-64 h-[calc(100vh-3.5rem)] bg-white border-r border-gray-200/60 overflow-y-auto transition-transform flex-shrink-0">
    <nav class="p-4 space-y-1">
      <!-- 搜索框 -->
      <div class="mb-3 px-1">
        <div class="relative">
          <input x-model="searchQuery" @keydown.enter="doSearch()" type="text" placeholder="搜索帖子..." class="w-full pl-9 pr-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 transition bg-gray-50 focus:bg-white">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <button x-show="searchQuery" @click="searchQuery=''; doSearch()" class="absolute right-2 top-1/2 -translate-y-1/2 p-1 rounded hover:bg-gray-200 transition">
            <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
      <div class="flex items-center justify-between mb-3 px-3">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">频道</p>
        <button x-show="isLoggedIn" @click="showCreateChannelModal()" class="text-xs text-gray-400 hover:text-primary-600 transition" title="创建频道">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        </button>
      </div>
      <button @click="filterCategory('hot')" :class="currentCat === 'hot' ? 'active' : ''" class="sidebar-link w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-600 hover:bg-gray-50 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"/></svg>
        热门
      </button>
      <!-- 频道列表 -->
      <template x-for="ch in channelsData" :key="ch.id">
        <div class="mt-1">
          <div class="flex items-center gap-1">
            <button @click="toggleChannel(ch.id)" :class="currentChannel === ch.id ? 'bg-primary-50 text-primary-700' : 'text-gray-600 hover:bg-gray-50'" class="sidebar-link flex-1 flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm transition min-w-0">
              <span class="text-lg" x-text="ch.icon || '💬'"></span>
              <span class="font-medium flex-1 truncate" x-text="ch.label"></span>
              <span class="text-xs text-gray-400" x-text="ch.member_count || 0"></span>
              <svg class="w-4 h-4 text-gray-400 transition-transform flex-shrink-0" :class="expandedChannels[ch.id] ? 'rotate-90' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>
            <button x-show="isLoggedIn && !ch.user_role && ch.join_policy !== 'deny'" @click="showJoinChannelModal(ch)" class="p-1.5 rounded-lg hover:bg-primary-50 transition text-primary-500 hover:text-primary-600" title="加入频道">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            </button>
            <button x-show="ch.user_role && ch.user_role !== 'owner' && !ch.is_official" @click="leaveChannel(ch.id, ch.label)" class="p-1.5 rounded-lg hover:bg-red-50 transition text-red-400 hover:text-red-500" title="退出频道">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            </button>
            <button x-show="ch.user_role === 'owner' || ch.user_role === 'admin' || isSuperAdmin" @click="showChannelSettings(ch)" class="p-1.5 rounded-lg hover:bg-gray-100 transition text-gray-400 hover:text-gray-600" title="频道设置">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </button>
            <button x-show="(ch.user_role === 'owner' || ch.user_role === 'admin' || isSuperAdmin) && ch.join_policy === 'verify'" @click="showChannelRequests(ch)" class="p-1.5 rounded-lg hover:bg-amber-50 transition text-amber-500 hover:text-amber-600" title="审核申请">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </button>
          </div>
          <!-- 频道板块列表 -->
          <div x-show="expandedChannels[ch.id]" class="ml-4 mt-1 space-y-0.5">
            <template x-for="board in channelBoards[ch.id] || []" :key="board.id">
              <button @click="filterCategory(board.name)" :data-cat="board.name" :class="currentCat === board.name ? 'active' : ''" class="sidebar-link w-full flex items-center gap-3 px-3 py-2 rounded-xl text-sm text-gray-600 hover:bg-gray-50 transition">
                <span class="text-base" x-text="board.icon || '💬'"></span>
                <span x-text="board.label"></span>
              </button>
            </template>
            <button x-show="isLoggedIn && (ch.user_role === 'owner' || ch.user_role === 'admin' || isAdmin)" @click="showCreateBoardModal(ch.id)" class="w-full flex items-center gap-2 px-3 py-2 rounded-xl text-xs text-gray-400 hover:text-primary-600 hover:bg-gray-50 transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              添加板块
            </button>
          </div>
        </div>
      </template>
    </nav>
    <div class="px-4 pb-4">
      <a href="/shop" class="sidebar-link w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-600 hover:bg-gray-50 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        积分商店
      </a>
    </div>
    <div class="px-4 pb-4">
      <button @click="showGameModal()" class="sidebar-link w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-gray-600 hover:bg-gray-50 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        在线游戏
      </button>
    </div>
    <div class="px-4 pb-4">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3 px-1">热门标签</p>
      <div class="flex flex-wrap gap-1.5 px-1">
        <template x-for="t in tagCloud" :key="t.name">
          <button @click="filterByTag(t.name)" :class="currentTag === t.name ? 'bg-primary-100 text-primary-700' : ''" class="px-2 py-0.5 text-xs rounded-full bg-gray-100 text-gray-500 hover:bg-primary-50 hover:text-primary-600 transition">
            #<span x-text="t.name"></span> <span class="text-gray-300" x-text="t.count"></span>
          </button>
        </template>
        <span x-show="tagCloud.length === 0" class="text-xs text-gray-300">暂无标签</span>
      </div>
    </div>
    <div class="p-4">
      <div class="bg-gradient-to-br from-primary-500 to-primary-700 rounded-2xl p-4 text-white">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span class="font-semibold text-sm">每日签到</span>
          </div>
          <span x-show="isLoggedIn" x-text="userPoints + ' 积分'" class="text-xs bg-white/20 px-2 py-0.5 rounded-full"></span>
        </div>
        <div x-show="isLoggedIn && checkinLoaded" class="flex gap-4 mb-3 text-center">
          <div class="flex-1"><div class="streak-num" x-text="checkinStreak">0</div><div class="text-xs text-white/60">连续签到</div></div>
          <div class="flex-1"><div class="streak-num" x-text="checkinTotal">0</div><div class="text-xs text-white/60">累计签到</div></div>
        </div>
        <div x-show="isLoggedIn && todayCheckedIn" class="text-center text-sm text-white/80 mb-2">✓ 今日已签到</div>
        <button @click="showCheckinHistory()" class="w-full py-1.5 bg-white/10 hover:bg-white/20 text-white text-xs rounded-xl transition">查看签到日历</button>
      </div>
    </div>
    <div class="p-4">
      <div class="bg-gray-50 rounded-2xl p-4 space-y-3">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">社区统计</p>
        <div class="flex justify-between text-sm"><span class="text-gray-500">话题数</span><span class="font-semibold" x-text="statPosts">-</span></div>
        <div class="flex justify-between text-sm"><span class="text-gray-500">评论数</span><span class="font-semibold" x-text="statComments">-</span></div>
      </div>
    </div>
  </aside>
  <main class="flex-1 min-w-0 p-4 lg:p-6">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-xl font-bold text-gray-900" x-text="pageTitle">全部话题</h1>
        <p class="text-sm text-gray-500 mt-0.5" x-text="pageSub">欢迎来到社区，参与讨论吧</p>
      </div>
      <button @click="showNewPostModal()" class="flex items-center gap-2 px-4 py-2.5 bg-primary-600 text-white text-sm font-medium rounded-xl hover:bg-primary-700 shadow-lg shadow-primary-600/20 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        发布新话题
      </button>
    </div>
    <div x-show="currentCat !== 'hot'" class="flex items-center gap-1 mb-4 overflow-x-auto">
      <template x-for="s in sortOptions" :key="s.value">
        <button @click="setSort(s.value)" :class="currentSort === s.value ? 'bg-primary-100 text-primary-700' : 'bg-gray-100 text-gray-500 hover:bg-gray-200'" class="px-3 py-1.5 text-xs font-medium rounded-lg transition whitespace-nowrap" x-text="s.label"></button>
      </template>
    </div>
    <div x-show="loading" class="space-y-3">
      <div class="bg-white rounded-xl border border-gray-100 p-5"><div class="flex gap-3"><div class="w-9 h-9 rounded-full skeleton flex-shrink-0"></div><div class="flex-1 space-y-2"><div class="h-4 w-24 skeleton rounded"></div><div class="h-5 w-3/4 skeleton rounded"></div><div class="h-4 w-full skeleton rounded"></div></div></div></div>
      <div class="bg-white rounded-xl border border-gray-100 p-5"><div class="flex gap-3"><div class="w-9 h-9 rounded-full skeleton flex-shrink-0"></div><div class="flex-1 space-y-2"><div class="h-4 w-24 skeleton rounded"></div><div class="h-5 w-3/4 skeleton rounded"></div><div class="h-4 w-full skeleton rounded"></div></div></div></div>
      <div class="bg-white rounded-xl border border-gray-100 p-5"><div class="flex gap-3"><div class="w-9 h-9 rounded-full skeleton flex-shrink-0"></div><div class="flex-1 space-y-2"><div class="h-4 w-24 skeleton rounded"></div><div class="h-5 w-3/4 skeleton rounded"></div><div class="h-4 w-full skeleton rounded"></div></div></div></div>
    </div>
    <div x-show="!loading" class="space-y-3">
      <template x-for="p in posts" :key="p.id">
        <div class="post-card bg-white rounded-xl border border-gray-100 p-4 sm:p-5 cursor-pointer transition hover:border-gray-200" @click="location.href='/post.html?id=' + p.id">
          <div class="flex items-start gap-3">
            <a :href="'/profile.html?id=' + p.author_id" @click.stop class="flex-shrink-0" x-html="postAvatarHtml(p)"></a>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-sm font-semibold text-gray-900" x-text="p.author_name"></span>
                <span x-show="p.author_title" x-text="p.author_title" class="text-[10px] px-1.5 py-0.5 rounded bg-gray-100 text-gray-500"></span>
                <span x-show="p.author_level_info" :style="'background:' + (p.author_level_info && p.author_level_info.badge_bg)" x-text="p.author_level_info && (p.author_level_info.icon + 'Lv' + p.author_level_info.level)" class="inline-flex items-center gap-0.5 text-[9px] px-1 py-px rounded-full text-white font-bold leading-none"></span>
                <span class="text-xs text-gray-400" x-text="'#' + p.author_display_id"></span>
                <span class="text-xs text-gray-400" x-text="relTime(p.created_at)"></span>
                <span :class="catColorClass(p.category)" x-text="catLabel(p.category)" class="text-xs px-2 py-0.5 rounded-full cursor-pointer hover:opacity-80 transition" @click.stop="filterCategory(p.category)"></span>
                <span x-show="p.updated_at" class="text-xs text-gray-400">(已编辑)</span>
                <span x-show="p.images && p.images.length > 1" class="text-xs text-gray-400" x-text="'📷' + p.images.length"></span>
                <span x-show="p.pinned" class="text-xs px-2 py-0.5 rounded-full bg-amber-100 text-amber-700">置顶</span>
                <span x-show="p.private" class="text-xs px-2 py-0.5 rounded-full bg-gray-200 text-gray-500">私密</span>
                <template x-if="isAdmin">
                  <span class="ml-auto flex items-center gap-1">
                    <button @click.stop="togglePinPost(p)" :class="p.pinned ? 'bg-amber-100 text-amber-700' : 'bg-gray-100 text-gray-500'" class="text-xs px-2 py-0.5 rounded-lg hover:bg-amber-200 transition" x-text="p.pinned ? '取消置顶' : '置顶'"></button>
                    <button @click.stop="adminDeletePost(p.id)" class="text-xs px-2 py-0.5 rounded-lg bg-red-50 text-red-500 hover:bg-red-100 transition">删除</button>
                  </span>
                </template>
              </div>
              <h3 class="text-base font-semibold text-gray-900 mb-1 line-clamp-1" x-text="p.title"></h3>
              <p class="text-sm text-gray-500 line-clamp-2" x-html="renderPostPreview(p)"></p>
              <div x-show="p.tags && p.tags.length" class="flex flex-wrap gap-1.5 mt-1.5">
                <template x-for="(tag, ti) in (p._showAllTags ? p.tags : (p.tags || []).slice(0, 3))" :key="tag">
                  <span class="text-xs px-1.5 py-0.5 rounded bg-gray-100 text-gray-500 cursor-pointer hover:bg-primary-50 hover:text-primary-600 transition" @click.stop="filterByTag(tag)" x-text="'#' + tag"></span>
                </template>
                <button x-show="p.tags && p.tags.length > 3" @click.stop="p._showAllTags = !p._showAllTags" class="text-xs text-primary-500 hover:text-primary-700 cursor-pointer transition" x-text="p._showAllTags ? '收起' : '展开全部'"></button>
              </div>
              <img x-show="p.images && p.images.length > 0" :src="p.images && p.images[0]" class="mt-2 rounded-lg max-h-24 object-cover" @click.stop="openLightbox(p.images[0])">
              <div class="flex items-center gap-2 sm:gap-4 mt-3">
                <button @click.stop="toggleLike(p)" :class="likedIds.has(p.id) ? 'text-red-500' : 'text-gray-400'" class="flex items-center gap-1 text-xs hover:text-red-500 transition p-2 -m-2 min-w-[44px] min-h-[44px] justify-center" title="点赞">
                  <svg class="w-4 h-4" :fill="likedIds.has(p.id) ? 'currentColor' : 'none'" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                  <span x-text="p.likes_count || 0"></span>
                </button>
                <span class="flex items-center gap-1 text-xs text-gray-400 p-2 -m-2 min-w-[44px] min-h-[44px] justify-center">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                  <span x-text="p.comments_count || 0"></span>
                </span>
                <button @click.stop="toggleBookmark(p)" :class="bookmarkedIds.has(p.id) ? 'text-yellow-500' : 'text-gray-400'" class="flex items-center gap-1 text-xs hover:text-yellow-500 transition p-2 -m-2 min-w-[44px] min-h-[44px] justify-center" title="收藏">
                  <svg class="w-4 h-4" :fill="bookmarkedIds.has(p.id) ? 'currentColor' : 'none'" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                </button>
                <button @click.stop="sharePost({id:p.id,title:p.title,content:(p.content||'').slice(0,100)}, $event)" class="flex items-center gap-1 text-xs text-gray-400 hover:text-primary-500 transition p-2 -m-2 min-w-[44px] min-h-[44px] justify-center" title="分享">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </template>
    </div>
    <div x-show="!loading && posts.length === 0" class="text-center py-20">
      <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
      <p class="text-gray-400">暂无话题，快来发布第一条吧</p>
    </div>
    <div x-show="pagination.pages > 1" class="flex items-center justify-center gap-2 mt-6">
      <button x-show="pagination.page > 1" @click="loadPosts(pagination.page - 1)" class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg hover:bg-gray-50 transition">上一页</button>
      <template x-for="pg in paginationRange" :key="pg">
        <button @click="loadPosts(pg)" :class="pg === pagination.page ? 'w-8 h-8 text-sm bg-primary-600 text-white rounded-lg' : 'w-8 h-8 text-sm border border-gray-200 rounded-lg hover:bg-gray-50 transition'" x-text="pg"></button>
      </template>
      <button x-show="pagination.page < pagination.pages" @click="loadPosts(pagination.page + 1)" class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg hover:bg-gray-50 transition">下一页</button>
      <span class="text-xs text-gray-400 ml-2" x-text="'共 ' + pagination.total + ' 条'"></span>
    </div>
  </main>
</div>

<!-- New Post Modal -->
<div x-show="newPostOpen" x-transition.opacity @click.self="closeNewPostModal()" @keydown.escape.window="if(newPostOpen) closeNewPostModal()" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm" style="display:none" role="dialog" aria-modal="true" aria-label="发布话题">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg mx-4 max-h-[90vh] flex flex-col fade-in">
    <div class="flex items-center justify-between p-5 border-b border-gray-100 flex-shrink-0">
      <div class="flex items-center gap-2">
        <h2 class="text-lg font-bold" x-text="editingPostId ? '编辑话题' : '发布新话题'">发布新话题</h2>
        <span x-show="hasDraft && !editingPostId" class="text-xs px-2 py-0.5 rounded-full bg-amber-100 text-amber-700">有草稿</span>
      </div>
      <button @click="closeNewPostModal()" class="p-1 rounded-lg hover:bg-gray-100"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
    </div>
    <div class="flex-1 overflow-y-auto p-5 space-y-4">
      <div><label class="block text-sm font-medium text-gray-700 mb-1">标题</label><input x-model="newPostTitle" type="text" placeholder="请输入话题标题" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 transition"></div>
      <div><label class="block text-sm font-medium text-gray-700 mb-1">分类</label><select x-model="newPostCategory" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 transition bg-white">
        <template x-for="c in postableCategories" :key="c.name">
          <option :value="c.name" x-text="c.label"></option>
        </template>
      </select></div>
      <div><label class="block text-sm font-medium text-gray-700 mb-1">正文</label><textarea x-model="newPostContent" rows="5" placeholder="分享你的想法..." class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 transition resize-none"></textarea></div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">图片（可选，最多30张，每张10MB）</label>
        <div class="flex flex-wrap gap-2">
          <template x-for="(f, idx) in selectedImages" :key="idx">
            <div class="relative w-20 h-20 rounded-lg group" draggable="true" @dragstart="dragImageIdx = idx" @dragover.prevent @drop.prevent="dropImage(idx)">
              <img :src="f._url" class="w-full h-full object-cover rounded-lg">
              <div class="absolute inset-0 flex flex-col items-center justify-end gap-0.5 opacity-0 group-hover:opacity-100 transition bg-black/30 rounded-lg">
                <button @click="insertImageAtCursor(idx)" class="w-full py-1 bg-primary-600/90 text-white text-[11px] font-medium hover:bg-primary-700 transition">插入正文</button>
                <button @click="URL.revokeObjectURL(selectedImages[idx]._url); selectedImages.splice(idx, 1)" class="w-full py-1 bg-red-500/90 text-white text-[11px] font-medium hover:bg-red-600 transition">删除</button>
              </div>
              <span class="absolute top-1 left-1 w-5 h-5 bg-black/60 text-white text-[10px] rounded-full flex items-center justify-center font-bold" x-text="idx + 1"></span>
            </div>
          </template>
          <div x-show="selectedImages.length < 30" @click="$refs.postImagesInput.click()" class="w-20 h-20 border-2 border-dashed border-gray-200 rounded-lg flex items-center justify-center cursor-pointer hover:border-primary-300 transition mt-2">
            <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          </div>
        </div>
        <input type="file" x-ref="postImagesInput" accept=".jpg,.jpeg,.png,.gif,.webp,.bmp" multiple class="hidden" @change="handleImageSelect($event)">
        <p class="text-xs text-gray-400 mt-1">支持 JPG / PNG / GIF / WebP / BMP，单张最大 10MB</p>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">标签（可选，最多10个）</label>
        <div class="flex flex-wrap gap-1.5 p-2 border border-gray-200 rounded-xl min-h-[42px] cursor-text" @click="$refs.tagInputRef.focus()">
          <template x-for="(tag, ti) in newPostTags" :key="ti">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-primary-50 text-primary-700 rounded-full text-xs">
              <span x-text="tag"></span>
              <button @click="newPostTags.splice(ti, 1)" class="hover:text-primary-900">&times;</button>
            </span>
          </template>
          <input x-ref="tagInputRef" type="text" class="flex-1 min-w-[60px] text-sm outline-none bg-transparent" placeholder="输入标签回车确认" @keydown.enter.prevent="addTag()" @keydown.,="addTag()">
        </div>
        <p class="text-xs text-gray-400 mt-1">回车添加，每个标签最多20字</p>
      </div>
      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="text-sm font-medium text-gray-700">投票（可选）</label>
          <button @click="showPollForm = !showPollForm" class="text-xs text-primary-500 hover:text-primary-700 transition" x-text="showPollForm ? '取消投票' : '添加投票'"></button>
        </div>
        <div x-show="showPollForm" class="space-y-3 p-3 bg-gray-50 rounded-xl border border-gray-200">
          <input x-model="pollQuestion" type="text" placeholder="投票问题" class="w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-300">
          <div class="space-y-2">
            <template x-for="(opt, oi) in pollOptions" :key="oi">
              <div class="flex gap-2">
                <input x-model="pollOptions[oi]" type="text" :placeholder="'选项' + (oi+1)" class="flex-1 px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-300">
                <button @click="removePollOption(oi)" class="text-gray-400 hover:text-red-500"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
              </div>
            </template>
          </div>
          <button @click="addPollOption()" class="text-xs text-primary-500 hover:text-primary-700">+ 添加选项</button>
          <label class="flex items-center gap-1.5 text-sm">
            <input x-model="pollMultiple" type="checkbox" class="w-3.5 h-3.5 rounded text-primary-600">
            <span>允许多选</span>
          </label>
          <div>
            <label class="text-xs text-gray-500">投票时长</label>
            <select x-model="pollDuration" class="w-full px-3 py-1.5 border border-gray-200 rounded-lg text-sm bg-white focus:outline-none">
              <option value="">不限时</option>
              <option value="1h">1小时</option>
              <option value="6h">6小时</option>
              <option value="1d">1天</option>
              <option value="3d">3天</option>
              <option value="7d">7天</option>
              <option value="30d">30天</option>
            </select>
          </div>
        </div>
      </div>
      <label class="flex items-center gap-2 cursor-pointer">
        <input x-model="newPostPrivate" type="checkbox" class="w-4 h-4 rounded text-primary-600 focus:ring-primary-500">
        <span class="text-sm text-gray-600">私密帖子（仅自己可见）</span>
      </label>
    </div>
    <div class="p-5 border-t border-gray-100 flex-shrink-0 flex gap-3">
      <button x-show="hasDraft && !editingPostId" @click="discardDraft()" class="px-4 py-2.5 border border-gray-200 text-gray-500 text-sm rounded-xl hover:bg-gray-50 transition">清除草稿</button>
      <button @click="doNewPost()" :disabled="submittingPost" class="flex-1 py-2.5 bg-primary-600 text-white text-sm font-semibold rounded-xl hover:bg-primary-700 transition" x-text="submittingPost ? '发布中...' : '发布话题'"></button>
    </div>
  </div>
</div>

<!-- Category Management Modal -->
<div x-show="categoryModalOpen" x-transition.opacity @click.self="categoryModalOpen = false" @keydown.escape.window="if(categoryModalOpen) categoryModalOpen = false" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm" style="display:none" role="dialog" aria-modal="true" aria-label="分类管理">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md mx-4 p-6 fade-in max-h-[80vh] flex flex-col">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-lg font-bold">分类管理</h2>
      <button @click="categoryModalOpen = false" class="p-1 rounded-lg hover:bg-gray-100"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
    </div>
    <div class="flex-1 overflow-y-auto space-y-2 mb-4">
      <template x-for="c in categoriesData" :key="c.id">
        <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-xl">
          <span class="text-lg" x-text="c.icon || (c.sectionType === 'announcement' ? '📢' : c.sectionType === 'hot' ? '🔥' : '💬')"></span>
          <span class="text-xs px-2 py-1 rounded-full" :class="c.color" x-text="c.label"></span>
          <span class="text-xs text-gray-400 font-mono" x-text="c.name"></span>
          <span x-show="c.sectionType === 'announcement'" class="text-[10px] px-1.5 py-0.5 rounded bg-amber-100 text-amber-700">公告</span>
          <span x-show="c.sectionType === 'hot'" class="text-[10px] px-1.5 py-0.5 rounded bg-red-100 text-red-700">热门</span>
          <span x-show="c.created_by && c.sectionType === 'normal'" class="text-[10px] px-1.5 py-0.5 rounded bg-green-100 text-green-700">用户</span>
          <div class="ml-auto flex items-center gap-1">
            <button @click="editCategory(c)" class="px-2 py-1 text-xs bg-gray-200 hover:bg-gray-300 rounded-lg transition">编辑</button>
            <button x-show="c.sectionType !== 'announcement' && c.sectionType !== 'hot'" @click="deleteCategory(c)" class="px-2 py-1 text-xs bg-red-50 text-red-500 hover:bg-red-100 rounded-lg transition">删除</button>
          </div>
        </div>
      </template>
      <p x-show="categoriesData.length === 0" class="text-sm text-gray-400 text-center py-4">暂无分类</p>
    </div>
    <div class="border-t border-gray-100 pt-4 space-y-2">
      <p class="text-xs font-medium text-gray-500">添加新分类</p>
      <div class="flex gap-2 items-center">
        <input x-model="newCatName" type="text" class="w-24 px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 transition" placeholder="标识">
        <input x-model="newCatLabel" type="text" class="flex-1 min-w-0 px-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 transition" placeholder="显示名">
        <button @click="createCategory()" class="shrink-0 px-3 py-2 bg-primary-600 text-white text-sm rounded-xl hover:bg-primary-700 transition">添加</button>
      </div>
    </div>
  </div>
</div>

<!-- Check-in History Modal -->
<div x-show="checkinModalOpen" x-transition.opacity @click.self="checkinModalOpen = false" @keydown.escape.window="if(checkinModalOpen) checkinModalOpen = false" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm" style="display:none" role="dialog" aria-modal="true" aria-label="签到日历">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl mx-4 max-h-[90vh] flex flex-col fade-in">
    <div class="flex items-center justify-between p-5 border-b border-gray-100">
      <h2 class="text-lg font-bold">签到日历</h2>
      <button @click="checkinModalOpen = false" class="p-1 rounded-lg hover:bg-gray-100"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
    </div>
    <div class="flex-1 overflow-y-auto p-5 space-y-5">
      <div class="grid grid-cols-4 gap-3">
        <div class="bg-gray-50 rounded-xl p-3 text-center"><div class="streak-num text-primary-600" x-text="calStats.currentStreak">0</div><div class="text-xs text-gray-500 mt-1">连续签到</div></div>
        <div class="bg-gray-50 rounded-xl p-3 text-center"><div class="streak-num text-amber-500" x-text="calStats.longestStreak">0</div><div class="text-xs text-gray-500 mt-1">最长连续</div></div>
        <div class="bg-gray-50 rounded-xl p-3 text-center"><div class="streak-num text-green-600" x-text="calStats.totalDays">0</div><div class="text-xs text-gray-500 mt-1">累计签到</div></div>
        <div class="bg-gray-50 rounded-xl p-3 text-center"><div class="streak-num text-gray-400" x-text="calStats.missedCount">0</div><div class="text-xs text-gray-500 mt-1">可补签</div></div>
      </div>
      <div>
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-semibold text-gray-700">签到日历</h3>
          <div class="flex items-center gap-3 text-xs text-gray-400">
            <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>已签</span>
            <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-red-200 inline-block"></span>未签</span>
          </div>
        </div>
        <div class="flex items-center justify-between mb-3">
          <button @click="calPrev()" class="p-1.5 rounded-lg hover:bg-gray-100 transition">
            <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <div class="flex items-center gap-2">
            <div class="relative">
              <button @click="showMonthPicker = !showMonthPicker" class="text-base font-bold text-gray-800 hover:text-primary-600 transition cursor-pointer px-3 py-1 rounded-lg hover:bg-gray-100 flex items-center gap-1">
                <span x-text="calYear + '年' + (calMonth + 1) + '月'"></span>
                <svg class="w-3.5 h-3.5 inline-block text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <div x-show="showMonthPicker" @click.outside="showMonthPicker = false" class="absolute top-full mt-2 bg-white rounded-xl shadow-xl border border-gray-100 p-3 z-10 fade-in" style="width:240px;left:50%;margin-left:-120px">
                <div class="grid grid-cols-3 gap-2">
                  <template x-for="(mn, mi) in monthNames" :key="mi">
                    <button @click="selectMonth(mi)" :class="mi === calMonth ? 'bg-primary-600 text-white font-semibold' : 'text-gray-600 hover:bg-gray-100'" class="py-2 text-sm rounded-lg transition" x-text="mn"></button>
                  </template>
                </div>
              </div>
            </div>
            <button @click="calGoToday()" class="text-xs px-2 py-1 rounded-lg bg-primary-50 text-primary-600 hover:bg-primary-100 font-medium transition">今天</button>
          </div>
          <button @click="calNext()" class="p-1.5 rounded-lg hover:bg-gray-100 transition">
            <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
        <div class="bg-gray-50 rounded-2xl p-4 overflow-hidden">
          <div class="cal-month mb-2">
            <span class="cal-head">日</span><span class="cal-head">一</span><span class="cal-head">二</span><span class="cal-head">三</span><span class="cal-head">四</span><span class="cal-head">五</span><span class="cal-head">六</span>
          </div>
          <div class="cal-month" style="transition:opacity .2s ease,transform .2s ease">
            <template x-for="(cell, ci) in calendarCells" :key="ci">
              <div :class="cell.cls" :style="cell.style" @click="cell.clickable ? doRetroactive(cell.dateStr) : null" :title="cell.title">
                <span x-show="cell.missed" x-text="cell.day"></span>
                <span x-show="!cell.missed" x-text="cell.day"></span>
              </div>
            </template>
          </div>
        </div>
      </div>
      <div x-show="calStats.missedCount > 0">
        <h3 class="text-sm font-semibold text-gray-700 mb-2">补签</h3>
        <p class="text-xs text-gray-500 mb-3">灰色格子为未签到日期，点击可补签，每次消耗 <strong x-text="retroactiveCost + ' 积分'">10 积分</strong></p>
        <div class="flex items-center gap-3 p-3 bg-amber-50 rounded-xl">
          <div class="flex-1">
            <div class="text-sm font-medium text-amber-800">当前积分：<span x-text="userPoints">0</span></div>
            <div class="text-xs text-amber-600">可补签 <span x-text="Math.min(calStats.missedCount, Math.floor(userPoints / retroactiveCost))">0</span> 天</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Create Section Modal -->
<div x-show="createSectionOpen" x-transition.opacity @click.self="createSectionOpen = false" @keydown.escape.window="if(createSectionOpen) createSectionOpen = false" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm" style="display:none" role="dialog" aria-modal="true" aria-label="创建板块">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm mx-4 p-6 fade-in">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-lg font-bold">创建板块</h2>
      <button @click="createSectionOpen = false" class="p-1 rounded-lg hover:bg-gray-100"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
    </div>
    <div class="space-y-3">
      <div><label class="block text-xs font-medium text-gray-500 mb-1">板块标识（英文）</label><input x-model="newSection.name" type="text" placeholder="如：game、music" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 transition"></div>
      <div><label class="block text-xs font-medium text-gray-500 mb-1">板块名称</label><input x-model="newSection.label" type="text" placeholder="如：游戏、音乐" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 transition"></div>
