<!DOCTYPE html>
<html lang="zh-CN" data-theme="<%= theme.theme %>" data-color="<%= theme.themeColor %>">
<head>
<%- include('partials/head', { title: '管理面板 - MiForum' }) %>
</head>
<body class="min-h-screen text-gray-800 bg-gray-50" x-data="adminPage()" x-cloak>

<%- include('partials/header', { subtitle: '管理面板', showAdminButton: false }) %>

<div class="max-w-4xl mx-auto px-4 py-6">
  <h1 class="text-xl font-bold text-gray-900 mb-5">管理面板</h1>

  <!-- 标签页切换 -->
  <div class="flex gap-1.5 mb-5 overflow-x-auto pb-1 -mx-1 px-1">
    <button @click="tab = 'users'; loadUsers()" :class="tab === 'users' ? 'bg-primary-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-100'" class="px-3 py-2 rounded-lg text-xs font-medium transition whitespace-nowrap flex-shrink-0">👥 用户</button>
    <button @click="tab = 'shop'; loadShopItems()" :class="tab === 'shop' ? 'bg-primary-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-100'" class="px-3 py-2 rounded-lg text-xs font-medium transition whitespace-nowrap flex-shrink-0">🎁 商品</button>
    <button @click="tab = 'codes'; loadCodes()" :class="tab === 'codes' ? 'bg-primary-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-100'" class="px-3 py-2 rounded-lg text-xs font-medium transition whitespace-nowrap flex-shrink-0">🎫 兑换码</button>
    <button @click="tab = 'orders'; loadOrders()" :class="tab === 'orders' ? 'bg-primary-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-100'" class="px-3 py-2 rounded-lg text-xs font-medium transition whitespace-nowrap flex-shrink-0">📋 记录</button>
    <button @click="tab = 'smtp'; loadSmtp()" :class="tab === 'smtp' ? 'bg-primary-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-100'" class="px-3 py-2 rounded-lg text-xs font-medium transition whitespace-nowrap flex-shrink-0">📧 邮箱</button>
    <button @click="tab = 'about'; loadVersion()" :class="tab === 'about' ? 'bg-primary-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-100'" class="px-3 py-2 rounded-lg text-xs font-medium transition whitespace-nowrap flex-shrink-0">ℹ️ 关于</button>
  </div>

  <!-- 用户管理 -->
  <section x-show="tab === 'users'" class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
      <h2 class="text-sm font-semibold text-gray-700">用户管理</h2>
      <span class="text-xs text-gray-400" x-text="users.length + ' 人'"></span>
    </div>
    <div class="max-h-[60vh] overflow-y-auto divide-y divide-gray-50">
      <template x-for="u in users" :key="u.id">
        <div class="flex items-center gap-3 px-4 py-2.5 hover:bg-gray-50 transition">
          <a :href="'/profile.html?id=' + u.id" class="flex-shrink-0" x-html="avatarHtml(u.avatar_url, u.username?.[0]?.toUpperCase(), 'w-8 h-8', u.avatar_frame)"></a>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-1.5">
              <span class="text-sm font-medium text-gray-900 truncate" x-text="u.username"></span>
              <span class="text-xs text-gray-400" x-text="'#' + u.display_id"></span>
              <span x-show="u.role === 'super_admin'" class="text-[10px] px-1.5 py-0.5 rounded bg-red-500 text-white">超管</span>
              <span x-show="u.role === 'admin'" class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500 text-white">管理</span>
              <span x-show="u.muted" class="text-[10px] px-1.5 py-0.5 rounded bg-red-100 text-red-500">禁言</span>
            </div>
            <div class="text-xs text-gray-400"><span x-text="u.email"></span> · <span x-text="u.points + '积分'"></span></div>
          </div>
          <div class="flex items-center gap-1 flex-shrink-0">
            <template x-if="isSuperAdmin && u.role !== 'super_admin'">
              <span class="contents">
                <button x-show="u.role !== 'admin'" @click="grantAdmin(u)" class="text-[11px] px-2 py-1 rounded bg-amber-500 text-white hover:bg-amber-600">管理</button>
                <button x-show="u.role === 'admin'" @click="revokeAdmin(u)" class="text-[11px] px-2 py-1 rounded bg-amber-50 text-amber-600 hover:bg-amber-100">撤销</button>
              </span>
            </template>
            <template x-if="u.role !== 'super_admin'">
              <span class="contents">
                <button @click="toggleMute(u)" :class="u.muted ? 'bg-green-50 text-green-600' : 'bg-gray-100 text-gray-500'" class="text-[11px] px-2 py-1 rounded hover:opacity-80" x-text="u.muted ? '解禁' : '禁言'"></button>
                <button @click="deleteUser(u)" class="text-[11px] px-2 py-1 rounded bg-red-50 text-red-500 hover:bg-red-100">删除</button>
              </span>
            </template>
          </div>
        </div>
      </template>
      <p x-show="users.length === 0" class="text-sm text-gray-400 text-center py-8">暂无用户</p>
    </div>
  </section>

  <!-- 商品管理 -->
  <section x-show="tab === 'shop'" class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
      <h2 class="text-sm font-semibold text-gray-700">商品管理</h2>
      <button @click="showItemForm = !showItemForm; editingItem = null; resetItemForm()" class="text-xs px-2.5 py-1 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition" x-text="showItemForm ? '取消' : '+ 添加商品'"></button>
    </div>
    <div x-show="showItemForm" class="p-4 border-b border-gray-100 space-y-3">
      <div class="grid gap-2" style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));">
        <div>
          <input x-model="itemForm.name" type="text" class="w-full px-3 py-1.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" placeholder="商品名称">
          <p class="text-[10px] text-gray-400 mt-1">显示在商店中的名称</p>
        </div>
        <div>
          <select x-model="itemForm.type" class="w-full px-3 py-1.5 border border-gray-200 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-primary-300"><option value="title">称号</option><option value="other">其它</option></select>
          <p class="text-[10px] text-gray-400 mt-1">称号会显示在用户名旁</p>
        </div>
      </div>
      <div>
        <input x-model="itemForm.description" type="text" class="w-full px-3 py-1.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" placeholder="商品描述">
        <p class="text-[10px] text-gray-400 mt-1">商品详情页显示的描述文字</p>
      </div>
      <div class="grid gap-2" style="grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));">
        <div>
          <input x-model="itemForm.icon" type="text" class="w-full px-3 py-1.5 border border-gray-200 rounded-lg text-sm" placeholder="图标 emoji">
          <p class="text-[10px] text-gray-400 mt-1">如 🎁 🌟</p>
        </div>
        <div x-show="itemForm.type === 'title'">
          <input x-model="itemForm.value" type="text" class="w-full px-3 py-1.5 border border-gray-200 rounded-lg text-sm" placeholder="称号文字">
          <p class="text-[10px] text-gray-400 mt-1">显示的称号内容</p>
        </div>
        <div x-show="itemForm.type === 'title'">
          <input x-model="itemForm.titleColor" type="color" class="w-full h-[34px] border border-gray-200 rounded-lg cursor-pointer">
          <p class="text-[10px] text-gray-400 mt-1">称号颜色</p>
        </div>
        <div>
          <input x-model.number="itemForm.price" type="number" min="0" class="w-full px-3 py-1.5 border border-gray-200 rounded-lg text-sm" placeholder="价格">
          <p class="text-[10px] text-gray-400 mt-1">兑换所需积分</p>
        </div>
      </div>
      <div class="grid gap-2" style="grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));">
        <div>
          <input x-model.number="itemForm.stock" type="number" min="-1" class="w-full px-3 py-1.5 border border-gray-200 rounded-lg text-sm" placeholder="库存">
          <p class="text-[10px] text-gray-400 mt-1">-1 为无限库存</p>
        </div>
        <div>
          <input x-model.number="itemForm.checkinRequired" type="number" min="0" class="w-full px-3 py-1.5 border border-gray-200 rounded-lg text-sm" placeholder="签到天数">
          <p class="text-[10px] text-gray-400 mt-1">需连续签到天数（0 无限制）</p>
        </div>
        <label class="flex items-center gap-1.5 px-2 mt-1"><input x-model="itemForm.enabled" type="checkbox" class="w-4 h-4 rounded text-primary-600"><span class="text-sm text-gray-600">立即上架</span></label>
      </div>
      <button @click="saveItem()" class="w-full py-2 bg-primary-600 text-white text-sm font-semibold rounded-lg hover:bg-primary-700 transition" x-text="editingItem ? '保存修改' : '添加商品'"></button>
    </div>
    <div class="max-h-[60vh] overflow-y-auto divide-y divide-gray-50">
      <template x-for="item in shopItems" :key="item.id">
        <div class="flex items-center gap-3 px-4 py-2 hover:bg-gray-50 transition">
          <span class="text-lg" x-text="item.icon || '🎁'"></span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-1.5">
              <span class="text-sm font-medium text-gray-900" x-text="item.name"></span>
              <span x-show="!item.enabled" class="text-[10px] px-1 py-0.5 rounded bg-red-100 text-red-500">下架</span>
              <span x-show="item.checkin_required > 0" class="text-[10px] px-1 py-0.5 rounded bg-amber-100 text-amber-600">签到<span x-text="item.checkin_required"></span>天</span>
            </div>
            <div class="text-xs text-gray-400"><span x-text="item.price + '积分'"></span> · <span x-text="item.stock === -1 ? '无限' : '库存' + item.stock"></span></div>
          </div>
          <div class="flex gap-1 flex-shrink-0">
            <button @click="editItem(item)" class="text-[11px] px-2 py-1 rounded bg-gray-100 text-gray-500 hover:bg-primary-50 hover:text-primary-600">编辑</button>
            <button @click="toggleItemEnabled(item)" :class="item.enabled ? 'bg-amber-50 text-amber-600' : 'bg-green-50 text-green-600'" class="text-[11px] px-2 py-1 rounded hover:opacity-80" x-text="item.enabled ? '下架' : '上架'"></button>
            <button @click="deleteItem(item)" class="text-[11px] px-2 py-1 rounded bg-red-50 text-red-500 hover:bg-red-100">删除</button>
          </div>
        </div>
      </template>
      <p x-show="shopItems.length === 0" class="text-sm text-gray-400 text-center py-8">暂无商品</p>
    </div>
  </section>

  <!-- 兑换码 -->
  <section x-show="tab === 'codes'" class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
      <h2 class="text-sm font-semibold text-gray-700">兑换码管理</h2>
      <button @click="showCodeForm = !showCodeForm" class="text-xs px-2.5 py-1 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition" x-text="showCodeForm ? '取消' : '+ 创建兑换码'"></button>
    </div>
    <div x-show="showCodeForm" class="p-4 border-b border-gray-100 space-y-3">
      <div class="grid gap-2" style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));">
        <div>
          <input x-model.number="codeForm.rewardValue" type="number" min="1" class="w-full px-3 py-1.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" placeholder="奖励积分">
          <p class="text-[10px] text-gray-400 mt-1">用户兑换后获得的积分数量</p>
        </div>
        <div>
          <input x-model.number="codeForm.maxUses" type="number" min="1" class="w-full px-3 py-1.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" placeholder="最大使用次数">
          <p class="text-[10px] text-gray-400 mt-1">该码可被多少人使用</p>
        </div>
      </div>
      <div>
        <input x-model="codeForm.expiresAt" type="datetime-local" class="w-full px-3 py-1.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-300">
        <p class="text-[10px] text-gray-400 mt-1">留空则永不过期</p>
      </div>
      <button @click="createCode()" class="w-full py-2 bg-primary-600 text-white text-sm font-semibold rounded-lg hover:bg-primary-700 transition">创建兑换码</button>
    </div>
    <div class="max-h-[60vh] overflow-y-auto divide-y divide-gray-50">
      <template x-for="code in codes" :key="code.id">
        <div class="flex items-center justify-between px-4 py-2.5 hover:bg-gray-50 transition">
          <div>
            <span class="text-sm font-mono font-bold text-primary-600" x-text="code.code"></span>
            <span class="text-xs text-gray-400 ml-1" x-text="code.reward_value + '积分'"></span>
            <div class="text-xs text-gray-400"><span x-text="'已用' + code.used_count + '/' + code.max_uses"></span><span x-show="code.expires_at"> · <span x-text="code.expires_at"></span></span></div>
          </div>
          <button @click="deleteCode(code)" class="text-[11px] px-2 py-1 rounded bg-red-50 text-red-500 hover:bg-red-100 flex-shrink-0">删除</button>
        </div>
      </template>
      <p x-show="codes.length === 0" class="text-sm text-gray-400 text-center py-8">暂无兑换码</p>
    </div>
  </section>

  <!-- 兑换记录 -->
  <section x-show="tab === 'orders'" class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
      <h2 class="text-sm font-semibold text-gray-700">兑换记录</h2>
      <span class="text-xs text-gray-400" x-text="ordersPagination ? ordersPagination.total + ' 条' : ''"></span>
    </div>
    <div class="max-h-[60vh] overflow-y-auto divide-y divide-gray-50">
      <template x-for="o in orders" :key="o.id">
        <div class="flex items-center gap-3 px-4 py-2.5">
          <span class="text-lg" x-text="o.item_icon || '🎁'"></span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-1.5">
              <span class="text-sm font-medium text-gray-900" x-text="o.username || '未知'"></span>
              <span class="text-xs text-gray-400">兑换了</span>
              <span class="text-sm font-medium text-primary-600" x-text="o.item_name"></span>
            </div>
            <div class="text-xs text-gray-400"><span x-text="'-' + o.price + '积分'"></span> · <span x-text="relTime(o.created_at)"></span></div>
          </div>
        </div>
      </template>
      <p x-show="orders.length === 0" class="text-sm text-gray-400 text-center py-8">暂无兑换记录</p>
    </div>
    <div x-show="ordersPagination && ordersPagination.pages > 1" class="flex justify-center gap-2 px-4 py-2 border-t border-gray-100">
      <button x-show="ordersPagination && ordersPagination.page > 1" @click="loadOrders(ordersPagination.page - 1)" class="px-3 py-1 text-xs border rounded-lg hover:bg-gray-50">上一页</button>
      <span class="px-3 py-1 text-xs text-gray-500" x-text="ordersPagination ? ordersPagination.page + '/' + ordersPagination.pages : ''"></span>
      <button x-show="ordersPagination && ordersPagination.page < ordersPagination.pages" @click="loadOrders(ordersPagination.page + 1)" class="px-3 py-1 text-xs border rounded-lg hover:bg-gray-50">下一页</button>
    </div>
  </section>

  <!-- 邮箱设置 -->
  <section x-show="tab === 'smtp'" class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="px-4 py-3 border-b border-gray-100">
      <h2 class="text-sm font-semibold text-gray-700">邮箱设置</h2>
    </div>
    <div class="p-4 space-y-3">
      <div class="grid gap-2" style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));">
        <input x-model="smtp.host" type="text" class="px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" placeholder="SMTP主机">
        <input x-model="smtp.port" type="text" class="px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" placeholder="端口">
      </div>
      <div class="grid gap-2" style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));">
        <input x-model="smtp.user" type="email" class="px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" placeholder="发件邮箱">
        <input x-model="smtp.pass" type="password" class="px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" :placeholder="smtp.configured ? '已配置' : '密码/授权码'">
      </div>
      <div class="flex gap-2">
        <button @click="saveSmtp()" class="flex-1 py-2 bg-primary-600 text-white text-sm font-semibold rounded-lg hover:bg-primary-700 transition">保存</button>
        <button @click="testSmtp()" class="flex-1 py-2 border border-gray-200 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition">测试连接</button>
      </div>
      <div x-show="smtpStatus" :class="smtpStatusOk ? 'text-green-600' : 'text-red-500'" class="text-center text-xs" x-text="smtpStatus"></div>
    </div>
  </section>

  <!-- 关于 -->
  <section x-show="tab === 'about'" class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="px-4 py-3 border-b border-gray-100">
      <h2 class="text-sm font-semibold text-gray-700">关于</h2>
    </div>
    <div class="p-4 space-y-4">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 bg-gradient-to-br from-primary-500 to-primary-700 rounded-xl flex items-center justify-center">
          <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.36 5.07L2 22l4.93-1.36C8.42 21.5 10.15 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm0 18c-1.61 0-3.14-.39-4.48-1.07l-.32-.17-2.93.81.81-2.93-.17-.32C4.39 15.14 4 13.61 4 12c0-4.41 3.59-8 8-8s8 3.59 8 8-3.59 8-8 8z"/></svg>
        </div>
        <div>
          <h3 class="text-base font-bold text-gray-900">MiForum</h3>
          <p class="text-xs text-gray-500">Flarum 风格轻量论坛</p>
          <p class="text-xs text-gray-400">v<%= '1.3.2' %> · MIT License</p>
        </div>
      </div>
      <div class="bg-gray-50 rounded-lg p-3 space-y-2">
        <a href="https://github.com/parkes-mimir/miforum" target="_blank" class="flex items-center gap-2 text-sm text-gray-700 hover:text-primary-600 transition">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          <span>GitHub 项目地址</span>
          <svg class="w-3 h-3 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
        </a>
        <p class="text-xs text-gray-400">MIT License · 欢迎 Star 和 PR</p>
      </div>
      <div class="space-y-2">
        <button @click="checkUpdate()" :disabled="updateChecking" class="w-full py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition" x-text="updateChecking ? '检查中...' : '检查更新'"></button>
        <div x-show="updateResult" :class="updateResultOk ? 'text-green-600' : 'text-amber-600'" class="text-center text-xs" x-html="updateResult"></div>
        <button x-show="updateHasNew" @click="doUpdate()" class="w-full py-2 bg-primary-600 text-white text-sm font-semibold rounded-lg hover:bg-primary-700 transition">立即更新</button>
      </div>
      <p class="text-center text-xs text-gray-400">Node.js + Express + SQLite · Tailwind + Alpine.js</p>
    </div>
  </section>

</div>

<%- include('partials/scripts') %>
<script src="/js/pages/admin.js?v=1.3.2"></script>
<script src="/js/alpine.min.js?v=1.3.2"></script>
</body>
</html>
