<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#4f46e5">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="MiForum">
<meta name="format-detection" content="telephone=no">
<link rel="manifest" href="/manifest.json">
<title><%= typeof title !== 'undefined' ? title : 'MiForum' %></title>
<meta property="og:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : 'MiForum' %>">
<meta property="og:description" content="<%= typeof ogDesc !== 'undefined' ? ogDesc : 'Flarum 风格的轻量论坛，技术交流与生活分享' %>">
<meta property="og:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : (typeof siteUrl !== 'undefined' && siteUrl ? siteUrl + '/preview.png' : '/preview.png') %>">
<meta property="og:type" content="website">
<% if (typeof pageUrl !== 'undefined' && pageUrl) { %>
<meta property="og:url" content="<%= pageUrl %>">
<% } %>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : 'MiForum' %>">
<meta name="twitter:description" content="<%= typeof ogDesc !== 'undefined' ? ogDesc : 'Flarum 风格的轻量论坛，技术交流与生活分享' %>">
<meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : (typeof siteUrl !== 'undefined' && siteUrl ? siteUrl + '/preview.png' : '/preview.png') %>">
<link rel="stylesheet" href="css/tailwind.css">
<style>
  *{font-family:system-ui,-apple-system,"Microsoft YaHei","PingFang SC",sans-serif}
  body{background:#f0f2f5}
  [x-cloak]{display:none!important}
  .fade-in{animation:fadeIn .2s ease-out}
  @keyframes fadeIn{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
  .toast-in{animation:slideUp .3s ease-out}
  @keyframes slideUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
  /* 滚动条 - Chrome/Safari */
  ::-webkit-scrollbar{width:6px}
  ::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:3px}
  /* 滚动条 - Firefox（仅应用于可滚动容器） */
  .overflow-y-auto,.overflow-x-auto{scrollbar-width:thin;scrollbar-color:#cbd5e1 transparent}
  .skeleton{background:linear-gradient(90deg,#e2e8f0 25%,#f1f5f9 50%,#e2e8f0 75%);background-size:200% 100%;animation:shimmer 1.5s infinite}
  @keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}
  .line-clamp-1{overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:1}
  .line-clamp-2{overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2}
  /* Firefox 暗色模式滚动条 */
  [data-theme="dark"] *{scrollbar-color:#475569 #1e293b}
</style>
<script type="speculationrules">
{
  "prefetch": [{"source": "list", "urls": ["/", "/shop", "/messages"]}],
  "prerender": [{"source": "document", "where": {"href_matches": "/*"}, "eagerness": "moderate"}]
}
</script>
<%- typeof extraStyles !== 'undefined' ? extraStyles : '' %>
